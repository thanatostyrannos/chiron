# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- uv ---
# uv.lock IS committed (reproducible env); the venv is not.

# --- Reference clones: reproduced by scripts/fetch_reference.sh, never committed ---
# Keep OUR notes at the top level (README.md, CODE_MAP.md, PROVENANCE.md) and our
# BibTeX. Everything else -- every clone -- is ignored.
#
# The rule is deliberately NOT `!research/reference/**/*.md`: that pattern un-ignores
# upstream markdown too, which would drag several thousand files out of vllm,
# transformers and friends into this repo on the first fetch.
research/reference/*
!research/reference/*.md
!research/reference/papers/
research/reference/papers/*
!research/reference/papers/*.bib
!research/reference/papers/*.md

# --- Weights, datasets, checkpoints, run artifacts (never in git; manifests only) ---
# Root-anchored so they don't collide with source modules (e.g. themis/src/themis/data/).
/data/
/checkpoints/
/runs/
*.safetensors
*.gguf
*.bin
*.pt
*.ckpt

# --- Seed / bootstrap artifacts: the prompt pack that generated this repo, not repo content ---
repo-seed/
seed-lab.ps1
research-lab-promptpack.zip
*.zip

# --- Claude Code tooling ---
# .claude/agents/ IS committed: the eight subagent definitions are lab state, and a
# session must cold-start from the repo alone. Only machine-local settings are ignored.
.claude/settings.local.json
.claude/*.local.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
